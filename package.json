{
  "name": "@ma.vu/env",
  "version": "1.0.0",
  "description": "Zero-dependency env validation with builder API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test --import tsx/esm test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "changeset": "changeset",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "release": "npm publish --access public && changeset git-tag",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ultrox/env"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
