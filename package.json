{
  "name": "@ma.vu/env",
  "version": "0.1.0",
  "description": "Zero-dependency env validation with builder API",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "node --test --import tsx/esm test/index.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --import tsx/esm test/index.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
